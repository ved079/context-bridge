{
  "manifest_version": 3,
  "name": "Context Bridge",
  "version": "5.0",
  "description": "Capture AI conversations from Claude, ChatGPT & Z.ai via internal APIs — clean exports in Markdown and JSON.",
  "permissions": [
    "storage",
    "activeTab",
    "downloads",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://chat.z.ai/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/common.js", "content/claude-api.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["content/common.js", "content/chatgpt-api.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://chat.z.ai/*"],
      "js": ["content/common.js", "content/zai-api.js"],
      "run_at": "document_idle"
    }
  ]
}
